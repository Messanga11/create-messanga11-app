{
  "name": "@starter/navigation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --import tsx scripts/generate-routes.mjs --check",
    "check": "node --import tsx scripts/generate-routes.mjs --check",
    "dev:mobile": "node scripts/dev.mjs mobile",
    "dev:web": "node scripts/dev.mjs web",
    "generate": "node --import tsx scripts/generate-routes.mjs",
    "test": "node --import tsx --test test/*.test.mjs",
    "typecheck": "node --import tsx scripts/generate-routes.mjs --check",
    "watch": "node --import tsx scripts/watch-routes.mjs"
  },
  "dependencies": {
    "@messanga11/core": "https://github.com/Messanga11/core/releases/download/core-v0.5.0/messanga11-core-0.5.0.tgz"
  }
