DATABASE_URL=postgresql://app_user:replace-me@postgres:5432/app
DATABASE_MIGRATION_URL=postgresql://migration_owner:replace-me@postgres:5432/app
REDIS_URL=rediss://redis.internal:6379
OIDC_ISSUER=https://identity.example.com/
OIDC_CLIENT_ID=replace-me
OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.com/authorize
OIDC_TOKEN_ENDPOINT=https://identity.example.com/oauth/token
OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
OIDC_REDIRECT_URI=https://app.example.com/api/auth/callback
OIDC_ALGORITHMS=RS256
# Generate with: openssl rand -base64 32
OIDC_TOKEN_ENCRYPTION_KEY=replace-with-canonical-32-byte-base64-key
WORKER_TENANT_IDS=replace-with-provisioned-tenant-id
EVENT_SINK_URL=https://events.example.com/messanga11
WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-characters
